{
  "name": "storekeeper-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StoreKeeper — transaction & accountability backend for physical tool cribs and site stores (PRD v3)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --import ./test/env-setup.ts --test --test-concurrency=1 --test-timeout=120000 test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx scripts/export-openapi.ts",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/type-provider-typebox": "^5.0.1",
    "@fastify/under-pressure": "^9.0.1",
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.5.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.0.14",
    "opossum": "^8.1.4",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.8",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "yaml": "2.9.1"
  }
}
