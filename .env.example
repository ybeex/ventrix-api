# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of the web app; used to build invite / password-reset links in emails.
APP_BASE_URL=http://localhost:5173
# Comma-separated trusted browser origins (CORS). Empty = no cross-origin access (fail closed).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=true
# Reject non-HTTPS requests (checked via X-Forwarded-Proto). Enable in production behind a TLS terminator.
FORCE_HTTPS=false
LOAD_SHEDDING=true

# ── Data stores ─────────────────────────────────────────────────────
# Point at PgBouncer (transaction pooling) in production — see references/performance-and-scale.md
DATABASE_URL=postgres://storekeeper:storekeeper@localhost:5432/storekeeper
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ── Auth & sessions ─────────────────────────────────────────────────
SESSION_TTL_SECONDS=43200
PIN_SESSION_TTL_SECONDS=28800
INVITE_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600

# ── Limits ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
MAX_LOCATIONS_PER_ORG=1
MAX_IMPORT_BYTES=5242880
MAX_IMPORT_ROWS=10000
INLINE_IMPORT_MAX_ROWS=500

# ── File storage (item photos, transaction snapshots) ───────────────
STORAGE_DRIVER=local            # local | s3  (s3 works with AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_LOCAL_DIR=.storage
MAX_UPLOAD_BYTES=5242880
FILE_URL_TTL_SECONDS=300
# HMAC secret for signed file URLs (local driver). >= 32 chars; REQUIRED in production.
FILE_URL_SECRET=change-me-change-me-change-me-change-me
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (nodemailer over Mailgun SMTP) ────────────────────────────
MAIL_DRIVER=log                 # mailgun | log | json   (mailgun REQUIRED in production)
MAIL_FROM="StoreKeeper <no-reply@mg.example.com>"
MAILGUN_SMTP_HOST=smtp.mailgun.org   # EU region: smtp.eu.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASS=
# Mailgun → Sending → Webhooks → "HTTP webhook signing key". Required in production: bounces/complaints POST to /v1/webhooks/mailgun and are verified with it.
MAILGUN_WEBHOOK_SIGNING_KEY=

# ── Resilience (circuit breakers) ───────────────────────────────────
CB_TIMEOUT_MS=8000
CB_ERROR_THRESHOLD_PCT=50
CB_RESET_TIMEOUT_MS=30000
CB_VOLUME_THRESHOLD=5

# ── Observability ───────────────────────────────────────────────────
# Bearer token required to scrape /metrics. REQUIRED in production.
METRICS_TOKEN=
